  "median_sequential_wall_s": 64.52160396899853,
  "median_concurrent_wall_s": 24.554001386997697,
  "median_paired_speedup": 2.6495408435157946,
  "probe_sha256": "57f794cebe81f6d57f83baad72c269f9006c90064a3cefed4b839fbadc09a566",
  "probe_source": "from __future__ import annotations\n\nimport asyncio\nimport hashlib\nimport importlib.metadata\nimport json\nimport os\nimport platform\nimport statistics\nimport sys\nimport time\nfrom contextlib import AsyncExitStack\nfrom datetime import timedelta\nfrom pathlib import Path\n\nfrom mcp import ClientSession, StdioServerParameters\nfrom mcp.client.stdio import stdio_client\n\nfrom md_mcp.validators import (\n    IMPLICIT_RUN_ALL_EXCLUDED,\n    SLOW_VALIDATORS,\n    available_validators,\n)\n\nROOT = Path(\"/mnt/Linux/github-projects/millennium-dawn-mcp\")\nBASE = Path(\"/mnt/Linux/github-projects/worktrees/millennium-dawn-mcp-review-pr323-sequential\")\nCONCURRENT = Path(\"/mnt/Linux/github-projects/worktrees/millennium-dawn-mcp-review-pr323-final\")\nMOD = Path(\"/mnt/Linux/github-projects/worktrees/Millennium-Dawn-mcp-validator-benchmark\")\nREVISIONS = {\n    \"sequential\": \"75edb1575272b1b54417f2d55d9a84a5a5bab741\",\n    \"concurrent\": \"3b092069a344cd8afa0d3472a396c33d38413c7b\",\n}\n\n\ndef _payload(result):\n    wire = result.model_dump(mode=\"json\", by_alias=True)\n    assert not wire[\"isError\"], wire\n    text = wire[\"content\"][0][\"text\"]\n    return json.loads(text), len(text.encode(\"utf-8\"))\n\n\ndef _stable(payload):\n    stable = dict(payload)\n    stable[\"validators\"] = [\n        {key: value for key, value in row.items() if key != \"elapsed_s\"}\n        for row in payload[\"validators\"]\n    ]\n    if \"issues\" in stable:\n        stable[\"issues\"] = sorted(stable[\"issues\"], key=lambda row: json.dumps(row, sort_keys=True))\n    return json.dumps(stable, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n\n\ndef _params(source, cache, cores):\n    source_root = source / \"src\"\n    env = os.environ.copy()\n    env.update(\n        {\n            \"MD_MAX_WORKERS\": \"14\",\n            \"MD_MCP_VALIDATOR_MODE\": \"isolated\",\n            \"MD_MCP_SERIAL_PARSE\": \"1\",\n            \"MD_MCP_CACHE_DIR\": str(cache),\n            \"PYTHONPATH\": str(source_root),\n        }\n    )\n    code = (\n        'import os,sys; from pathlib import Path; '\n        f'os.sched_setaffinity(0, {set(cores)!r}); '\n        f'sys.path.insert(0, {str(source_root)!r}); '\n        'import md_mcp; '\n        f'assert Path(md_mcp.__file__).resolve().parent == Path({str(source_root / \"md_mcp\")!r}); '\n        'from md_mcp.server import main; main()'\n    )\n    return StdioServerParameters(\n        command=sys.executable,\n        args=[\"-c\", code, \"serve\", \"--mod-root\", str(MOD)],\n        env=env,\n    )\n\n\nasync def _exercise(tmp_path):\n    sys.path.insert(0, str(ROOT))\n    from benchmarks.validator_concurrency import _select_physical_cpus\n\n    assert os.environ.get(\"MD_NO_CACHE\") != \"1\"\n    topology = _select_physical_cpus(sorted(os.sched_getaffinity(0)), 14)\n    cores = [row[0] for row in topology]\n    names = [\n        info.name\n        for info in available_validators(MOD)\n        if info.name not in SLOW_VALIDATORS | IMPLICIT_RUN_ALL_EXCLUDED\n    ]\n    assert len(names) == 47\n    schemas = {}\n    sessions = {}\n    async with AsyncExitStack() as stack:\n        for mode, source in [(\"sequential\", BASE), (\"concurrent\", CONCURRENT)]:\n            read, write = await stack.enter_async_context(\n                stdio_client(_params(source, tmp_path / mode, cores))\n            )\n            session = await stack.enter_async_context(\n                ClientSession(read, write, read_timeout_seconds=timedelta(seconds=600))\n            )\n            await session.initialize()\n            tools = (await session.list_tools()).model_dump(mode=\"json\", by_alias=True)\n            templates = (await session.list_resource_templates()).model_dump(\n                mode=\"json\", by_alias=True\n            )\n            assert len(tools[\"tools\"]) == 54\n            assert len(templates[\"resourceTemplates\"]) == 6\n            schemas[mode] = {\"tools\": tools, \"templates\": templates}\n            sessions[mode] = session\n        assert schemas[\"sequential\"] == schemas[\"concurrent\"]\n        reference = None\n\n        async def sample(mode, arguments, responsive=False):\n            nonlocal reference\n            started = time.perf_counter()\n            pending = asyncio.create_task(sessions[mode].call_tool(\"validate\", arguments))\n            fast_s = None\n            if responsive:\n                done, _ = await asyncio.wait({pending}, timeout=0.25)\n                assert not done, \"full validation finished before responsiveness check\"\n                fast_started = time.perf_counter()\n                fast = await asyncio.wait_for(\n                    sessions[mode].call_tool(\n                        \"calculate_days\", {\"year\": 2000, \"month\": 1, \"day\": 1}\n                    ),\n                    timeout=3,\n                )\n                fast_payload, _ = _payload(fast)\n                fast_s = time.perf_counter() - fast_started\n                assert fast_payload == {\"ok\": True, \"days\": 0}\n                assert not pending.done(), \"validation was not active during fast call\"\n            payload, wire_bytes = _payload(await pending)\n            wall_s = time.perf_counter() - started\n            assert payload[\"ok\"] is True, payload\n            assert [row[\"name\"] for row in payload[\"validators\"]] == names\n            assert all(\n                row[\"ok\"] and isinstance(row[\"elapsed_s\"], (int, float))\n                for row in payload[\"validators\"]\n            )\n            assert len(json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")) <= 100000\n            stable = _stable(payload)\n            if arguments.get(\"counts_only\"):\n                if reference is None:\n                    reference = stable\n                assert stable == reference, f\"{mode} MCP summary changed\"\n                assert wire_bytes <= 100000\n            return {\n                \"wall_s\": wall_s,\n                \"normalized_sha256\": hashlib.sha256(stable.encode()).hexdigest(),\n                \"wire_text_bytes\": wire_bytes,\n                \"validator_elapsed_s\": {\n                    row[\"name\"]: row[\"elapsed_s\"] for row in payload[\"validators\"]\n                },\n                \"fast_call_s\": fast_s,\n                \"stable\": stable,\n            }\n\n        warmup = {}\n        for mode in (\"sequential\", \"concurrent\"):\n            warmup[mode] = await sample(\n                mode, {\"counts_only\": True}, responsive=mode == \"concurrent\"\n            )\n        pairs = []\n        for index in range(3):\n            pair = {}\n            order = (\"sequential\", \"concurrent\") if index % 2 == 0 else (\"concurrent\", \"sequential\")\n            for mode in order:\n                pair[mode] = await sample(mode, {\"counts_only\": True})\n            pair[\"speedup\"] = pair[\"sequential\"][\"wall_s\"] / pair[\"concurrent\"][\"wall_s\"]\n            pairs.append(pair)\n        defaults = {}\n        for mode in (\"sequential\", \"concurrent\"):\n            defaults[mode] = await sample(mode, {})\n        assert (\n            defaults[\"sequential\"][\"stable\"] == defaults[\"concurrent\"][\"stable\"]\n        ), \"default MCP responses differ\"\n\n    assert reference is not None\n    normalized_summary = json.loads(reference)\n    for group in [warmup, defaults, *pairs]:\n        for mode in (\"sequential\", \"concurrent\"):\n            group[mode].pop(\"stable\")\n    report = {\n        \"transport\": \"MCP stdio\",\n        \"arguments\": {\"counts_only\": True},\n        \"source_revisions\": REVISIONS,\n        \"mod_root\": str(MOD),\n        \"mod_revision\": \"0b325f86d03928875fbded86991008ded7df8a8e\",\n        \"sdk_version\": importlib.metadata.version(\"mcp\"),\n        \"python\": sys.version,\n        \"platform\": platform.platform(),\n        \"host_logical_cpus\": os.cpu_count(),\n        \"selected_physical_cores\": [\n            dict(cpu=cpu, package_id=package, core_id=core) for cpu, package, core in topology\n        ],\n        \"server_md_max_workers\": 14,\n        \"concurrent_total_pool_budget\": 12,\n        \"concurrent_outer_workers\": 4,\n        \"concurrent_inner_pool_cap\": 3,\n        \"cache_conditions\": (\n            \"Validator disk caches enabled; full discarded warmup per server; \"\n            \"OS filesystem cache uncontrolled.\"\n        ),\n        \"validators\": names,\n        \"schemas_equal\": True,\n        \"discarded_warmup\": warmup,\n        \"samples\": pairs,\n        \"default_arguments_functional_probe\": defaults,\n        \"normalized_counts_only_response\": normalized_summary,\n        \"median_sequential_wall_s\": statistics.median(\n            pair[\"sequential\"][\"wall_s\"] for pair in pairs\n        ),\n        \"median_concurrent_wall_s\": statistics.median(\n            pair[\"concurrent\"][\"wall_s\"] for pair in pairs\n        ),\n        \"median_paired_speedup\": statistics.median(pair[\"speedup\"] for pair in pairs),\n        \"probe_sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n        \"probe_source\": Path(__file__).read_text(),\n    }\n    output = ROOT / \"benchmarks/results/validator-concurrency-mcp.json\"\n    output.write_text(json.dumps(report, indent=2) + \"\\n\")\n    print(\n        json.dumps(\n            {\n                key: report[key]\n                for key in (\n                    \"median_sequential_wall_s\",\n                    \"median_concurrent_wall_s\",\n                    \"median_paired_speedup\",\n                )\n            }\n        )\n    )\n    assert report[\"median_paired_speedup\"] >= 2\n\n\ndef test_live_mcp_run_all_comparison(tmp_path):\n    asyncio.run(_exercise(tmp_path))\n"
}
